# Set the real HTTPS domain before a production build. No domain is assumed.
PUBLIC_SITE_URL=

# Server-side only: used by `npm run images:generate`. Never commit a real key or expose it to the browser.
OPENAI_API_KEY=
# Optional overrides (defaults live in config/image-generation.mjs)
# OPENAI_IMAGE_MODEL_FLARE=gpt-image-2.5-flare
# OPENAI_IMAGE_MODEL_SUNBURST=gpt-image-2.5-sunburst
# OPENAI_IMAGE_QUALITY_DEFAULT=medium
# OPENAI_IMAGE_QUALITY_PREMIUM=high

---
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/500.css';
import '@fontsource/manrope/600.css';
import '@fontsource/manrope/700.css';
import '@fontsource/playfair-display/500.css';
import '@fontsource/playfair-display/600.css';
import '@fontsource/playfair-display/500-italic.css';
import '../styles/global.css';
import Photo from '../components/Photo.astro';
import images from '../data/images.json';
import Icon from '../components/Icon.astro';
import { business, nav, whatsapp, vehicles, tours, services } from '../data/site';
// Above-the-fold body and heading faces; preloading avoids discovering them only after the CSS is parsed.
import manropeBody from '@fontsource/manrope/files/manrope-latin-400-normal.woff2?url';
import playfairHeading from '@fontsource/playfair-display/files/playfair-display-latin-500-normal.woff2?url';
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const path = Astro.url.pathname;
const canonical = !noindex && Astro.site ? new URL(path, Astro.site).href : undefined;
const publicImage = new URL('/assets/brand/social-share.jpg', Astro.site).href;
const origin = Astro.site!.href;
const pageName = title.split(' — ')[0];
const parent = path.startsWith('/vehicles/')
  ? ['Vehicles', '/vehicles/']
  : path.startsWith('/tour-packages/')
    ? ['Tour Packages', '/tour-packages/']
    : path.startsWith('/services/')
      ? ['Services', '/services/']
      : undefined;
const crumbs = [{ name: 'Home', item: origin }];
if (parent && path !== parent[1]) crumbs.push({ name: parent[0], item: new URL(parent[1], origin).href });
if (path !== '/') crumbs.push({ name: pageName, item: new URL(path, origin).href });
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TravelAgency',
      '@id': `${origin}#business`,
      name: business.name,
      telephone: business.phone,
      email: business.email,
      areaServed: { '@type': 'Place', name: 'Goa, India' },
      url: origin,
      logo: new URL('/assets/brand/logo.jpg', origin).href,
      image: publicImage,
    },
    {
      '@type': 'WebSite',
      '@id': `${origin}#website`,
      url: origin,
      name: business.name,
      publisher: { '@id': `${origin}#business` },
      inLanguage: 'en-IN',
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': `${origin}#website` },
      about: { '@id': `${origin}#business` },
    },
    ...(path === '/'
      ? []
      : [
          {
            '@type': 'BreadcrumbList',
            '@id': `${canonical}#breadcrumbs`,
            itemListElement: crumbs.map((crumb, index) => ({
              '@type': 'ListItem',
              position: index + 1,
              ...crumb,
            })),
          },
        ]),
  ],
};
const submenus: Record<string, { label: string; href: string }[]> = {
  '/vehicles/': vehicles.map((v) => ({ label: v.short, href: `/vehicles/${v.slug}/` })),
  '/tour-packages/': tours.map((t) => ({ label: t.name, href: `/tour-packages/${t.slug}/` })),
  '/services/': services.map((s) => ({ label: s.name, href: `/services/${s.slug}/` })),
};
const introLogo = { srcset: images.logo.srcset, sizes: '280px' };
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | {business.name}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0f12" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={`${title} | ${business.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={business.name} />
    {canonical && <meta property="og:url" content={canonical} />}
    {publicImage && <meta property="og:image" content={publicImage} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Fatima Tour and Travel — Goa tours and driver-included travel" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ${business.name}`} />
    <meta name="twitter:description" content={description} />
    {publicImage && <meta name="twitter:image" content={publicImage} />}
    <meta name="twitter:image:alt" content="Fatima Tour and Travel — Goa tours and driver-included travel" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" as="font" type="font/woff2" href={manropeBody} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={playfairHeading} crossorigin />
    <script is:inline define:vars={{ introLogo }}>
      document.documentElement.classList.add('js');
      try {
        if (!sessionStorage.getItem('fatima-intro')) {
          document.documentElement.classList.add('intro');
          sessionStorage.setItem('fatima-intro', '1');
          // The intro logo <img> is lazy so repeat views skip it; fetch it early only when the intro plays.
          const preload = document.createElement('link');
          preload.rel = 'preload';
          preload.as = 'image';
          preload.setAttribute('imagesrcset', introLogo.srcset);
          preload.setAttribute('imagesizes', introLogo.sizes);
          document.head.append(preload);
        }
      } catch (e) {}
    </script>
    <noscript>
      <link rel="stylesheet" href="/no-script.css" />
    </noscript>
    {!noindex && (
      <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    )}
  </head>
  <body>
    {/* Lazy: the logo is only fetched when the first-visit intro is actually displayed. */}
    <div class="intro-screen" aria-hidden="true">
      <Photo name="logo" alt="" sizes={introLogo.sizes} />
      <span class="intro-line"></span>
    </div>
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <header class="site-header" id="top" data-header>
      <div class="container header-inner">
        <a href="/" class="brand" aria-label="Fatima Tour and Travel home">
          <Photo
            name="logo"
            alt="Fatima Tour and Travels"
            eager
            priority={false}
            sizes="(max-width: 1100px) 150px, 190px"
          />
        </a>
        <nav id="main-nav" class="main-nav" aria-label="Main navigation">
          <ul class="nav-list">
            {nav.map(([label, href]) => {
              const children = submenus[href];
              return (
                <li class:list={['nav-item', { 'has-menu': children }]}>
                  <a href={href} aria-current={isActive(href) ? 'page' : undefined}>
                    {label}
                  </a>
                  {children && (
                    <>
                      <button
                        type="button"
                        class="submenu-toggle"
                        aria-expanded="false"
                        aria-label={`Show ${label} menu`}
                      >
                        <Icon name="chevron" size={16} />
                      </button>
                      <div class:list={['submenu', { wide: children.length > 6 }]}>
                        <ul>
                          {children.map((child) => (
                            <li>
                              <a href={child.href} aria-current={path === child.href ? 'page' : undefined}>
                                {child.label}
                                <Icon name="arrow" size={14} />
                              </a>
                            </li>
                          ))}
                        </ul>
                        <a class="submenu-all" href={href}>
                          View all {label.toLowerCase()} <Icon name="arrow" size={14} />
                        </a>
                      </div>
                    </>
                  )}
                </li>
              );
            })}
            <li class="nav-item mobile-only">
              <a href="/faq/" aria-current={isActive('/faq/') ? 'page' : undefined}>
                FAQs
              </a>
            </li>
          </ul>
          <div class="nav-drawer-contact">
            <a class="button" href={`tel:${business.phone}`}>
              <span class="button-label">Call {business.displayPhone}</span>
              <span class="button-icon">
                <Icon name="phone" size={16} />
              </span>
            </a>
            <a class="button whatsapp" href={whatsapp()} target="_blank" rel="noopener noreferrer">
              <span class="button-label">WhatsApp us</span>
              <span class="button-icon">
                <Icon name="whatsapp" size={17} />
              </span>
            </a>
          </div>
        </nav>
        <div class="header-actions">
          <a class="header-phone" href={`tel:${business.phone}`}>
            <span class="header-phone-icon">
              <Icon name="phone" size={16} />
            </span>
            <span class="header-phone-text">
              <small>Call to book</small>
              {business.displayPhone}
            </span>
          </a>
          <button
            class="menu-toggle"
            aria-expanded="false"
            aria-controls="main-nav"
            aria-label="Open navigation"
          >
            <Icon name="menu" />
            <Icon name="close" />
          </button>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-top">
        <div class="footer-brand">
          <a href="/" aria-label="Fatima Tour and Travel home">
            <Photo name="logo" alt="Fatima Tour and Travels" sizes="220px" />
          </a>
          <p>
            Goa tours, taxis, airport transfers and driver-included travel for individuals, families, groups
            and businesses.
          </p>
          <div class="footer-cta">
            <a class="button" href="/contact/">
              <span class="button-label">Plan My Trip</span>
              <span class="button-icon">
                <Icon name="arrow" size={16} />
              </span>
            </a>
            <a class="button whatsapp" href={whatsapp()} target="_blank" rel="noopener noreferrer">
              <span class="button-label">WhatsApp</span>
              <span class="button-icon">
                <Icon name="whatsapp" size={17} />
              </span>
            </a>
          </div>
        </div>
        <div class="footer-col">
          <h2>Explore</h2>
          <ul>
            {nav.map(([label, href]) => (
              <li>
                <a href={href}>{label}</a>
              </li>
            ))}
            <li>
              <a href="/faq/">FAQs</a>
            </li>
            <li>
              <a href="/privacy-policy/">Privacy Policy</a>
            </li>
          </ul>
        </div>
        <div class="footer-col">
          <h2>Services</h2>
          <ul>
            {services.map((s) => (
              <li>
                <a href={`/services/${s.slug}/`}>{s.name}</a>
              </li>
            ))}
          </ul>
        </div>
        <div class="footer-col">
          <h2>Goa Tours</h2>
          <ul>
            {tours.map((t) => (
              <li>
                <a href={`/tour-packages/${t.slug}/`}>{t.name}</a>
              </li>
            ))}
          </ul>
        </div>
        <div class="footer-col footer-contact">
          <h2>Get in Touch</h2>
          <a href={`tel:${business.phone}`}>
            <Icon name="phone" size={17} />
            {business.displayPhone}
          </a>
          <a href={`mailto:${business.email}`}>
            <Icon name="mail" size={17} />
            {business.email}
          </a>
          <p>
            <Icon name="pin" size={17} />
            {business.location}
          </p>
        </div>
      </div>
      <div class="container footer-bottom">
        <p>
          © {new Date().getFullYear()} {business.name}. All rights reserved.
        </p>
        <p>Prices, routes and availability are confirmed with each quotation.</p>
        <a href="#top" class="back-to-top" aria-label="Back to top">
          <Icon name="arrow-up" size={18} />
        </a>
      </div>
    </footer>
    <aside aria-label="WhatsApp enquiry">
      <a
        class="floating-whatsapp"
        href={whatsapp()}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Enquire with Fatima Tour and Travel on WhatsApp"
      >
        <Icon name="whatsapp" size={30} />
      </a>
    </aside>
    <nav class="mobile-bar" aria-label="Quick contact">
      <a href={`tel:${business.phone}`}>
        <Icon name="phone" size={18} /> Call
      </a>
      <a href={whatsapp()} target="_blank" rel="noopener noreferrer" class="mobile-bar-whatsapp">
        <Icon name="whatsapp" size={20} /> WhatsApp
      </a>
      <a href="/contact/" class="mobile-bar-plan">
        Plan Trip <Icon name="arrow" size={16} />
      </a>
    </nav>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

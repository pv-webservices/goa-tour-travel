---
interface Props {
  items: string[][];
}
const { items } = Astro.props;
---

<div class="faq-list">
  {items.map(([question, answer]) => (
    <details>
      <summary>
        <span>{question}</span>
        <span class="faq-toggle" aria-hidden="true" />
      </summary>
      <p>{answer}</p>
    </details>
  ))}
</div>
